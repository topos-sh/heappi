# Copy to .env (git-ignored) and fill in. The app reads this file at start; shell variables take precedence.
ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=           # alternative to the API key, if you use OAuth with pi-ai
# HEAPPI_MODEL=claude-sonnet-5-5   # any Anthropic id in pi-ai's catalog, e.g. claude-opus-5-5, claude-haiku-5-5
# PORT=8788
