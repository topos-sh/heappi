+/* JS_SNAPSHOT_CHAIN: the state that was written becomes the new base.
+   The cells, atoms and strings of the old base keep their indexes, the
+   new ones follow them, and the bodies are the ones just collected. The
+   references of the old base and of the writer are transferred. */
+static int snap_promote_written_base(SnapWriter *w, uint64_t id)
+{
+    JSRuntime *rt = w->rt;
+    JSSnapshotBase *old = w->base, *base;
+    int i, n = old->cell_count + w->cell_count;
+    int n_str = old->str_count + w->str_count;
+
+    base = js_mallocz_rt(rt, sizeof(*base));
+    if (!base)
+        return snap_writer_oom(w);
+    base->id = id;
+    base->cells = js_malloc_rt(rt, sizeof(base->cells[0]) * max_int(n, 1));
+    base->atoms = js_malloc_rt(rt, sizeof(base->atoms[0]) * max_int(w->bc.idx_to_atom_count, 1));
+    base->strs = js_malloc_rt(rt, sizeof(base->strs[0]) * max_int(n_str, 1));
+    if (!base->cells || !base->atoms || !base->strs)
+        goto oom;
+    for(i = 0; i < old->cell_count; i++)
+        base->cells[i] = old->cells[i];
+    for(i = 0; i < w->cell_count; i++)
+        base->cells[old->cell_count + i] = w->cells[i];
+    for(i = 0; i < n; i++) {
+        if (snap_map_add(rt, &base->cell_map, base->cells[i].ptr, i))
+            goto oom;
+    }
+    for(i = 0; i < old->str_count; i++)
+        base->strs[i] = old->strs[i];
+    for(i = 0; i < w->str_count; i++)
+        base->strs[old->str_count + i] = w->strs[i].key;
+    for(i = 0; i < n_str; i++) {
+        if (snap_map_add(rt, &base->str_map, JS_VALUE_GET_PTR(base->strs[i]), i))
+            goto oom;
+    }
+    /* nothing can fail from here: take the references */
+    base->cell_count = n;
+    base->str_count = n_str;
+    for(i = 0; i < w->bc.idx_to_atom_count; i++)
+        base->atoms[i] = JS_DupAtom(w->ctx, w->bc.idx_to_atom[i]);
+    base->atom_count = w->bc.idx_to_atom_count;
+    for(i = 0; i < w->str_count; i++)
+        w->strs[i].key = JS_UNDEFINED;
+    w->cell_count = 0;
+    old->cell_count = 0;
+    old->str_count = 0;
+    base->bodies = w->base_bodies.buf;
+    base->body_offsets = w->base_offsets;
+    w->base_bodies.buf = NULL;
+    w->base_offsets = NULL;
+    JS_DropSnapshotBase(rt); /* the old base: its atoms, arrays and maps */
+    rt->snapshot_base = base;
+    return 0;
+ oom:
+    js_free_rt(rt, base->cells);
+    js_free_rt(rt, base->atoms);
+    js_free_rt(rt, base->strs);
+    snap_map_free(rt, &base->cell_map);
+    snap_map_free(rt, &base->str_map);
+    js_free_rt(rt, base);
+    return snap_writer_oom(w);
+}
