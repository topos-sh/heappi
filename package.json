{
  "name": "heappi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype and benchmarks of the agent image architecture: one heap per agent on the dquickts-chain engine",
  "license": "MIT",
  "scripts": {
    "build:engine": "./engine/build.sh",
    "smoke": "node --no-warnings host/smoke.mjs",
    "demo": "node --no-warnings host/demo.mjs 3",
    "bench": "node --no-warnings bench/run.mjs",
    "test": "node --no-warnings host/tests.mjs",
    "cf:sync": "./cf/sync.sh",
    "build:harness": "./embed/build.sh",
    "app": "npm run -s build:harness && node --no-warnings app/server.mjs",
    "app:demo": "npm run -s build:harness && node --no-warnings app/server.mjs --demo"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
